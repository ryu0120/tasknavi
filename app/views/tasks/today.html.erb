<div class="dashboard-container">
  <!-- ヘッダー -->
  <header>
    <div class="logo">TaskNavi</div>
    <div class="header-right">
      <span class="user-welcome">ようこそ、<strong><%= current_user.nickname %></strong> さん</span>
      <%= link_to "カレンダー表示", "#", class: "btn btn-secondary" %>
      <button class="btn btn-primary" onclick="openModal()">＋ 予定・締め切りを追加</button>
      <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-logout" %>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <div class="container">
    <!-- 左側：タスクエリア -->
    <main>
      <!-- サマリー（進行度メーター） -->
      <section class="card summary-box">
        <div class="summary-text" id="summary-remaining">今日やるべきこと：計算中...</div>
        <p class="summary-progress-text" id="summary-progress-text">本日の進行度 (0/0 完了)</p>
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" id="progress-bar-fill"></div>
        </div>
      </section>

      <!-- 今日やるタスク -->
      <section class="card">
        <h2 class="card-title">
          <span>今日やるタスク</span>
          <span class="card-title-sub">本日：<%= Time.current.strftime("%Y年%m月%d日") %></span>
        </h2>
        <ul class="task-list" id="today-task-list">
          <li class="task-item">
            <input type="checkbox" class="task-checkbox" onchange="toggleTask(this)">
            <div class="task-content">
              <div class="task-title">【仕事】企画書の最終チェック・提出</div>
              <div class="task-meta">17:00まで / 締め切り本日</div>
            </div>
            <span class="badge badge-urgent">本日締切</span>
          </li>
          <li class="task-item">
            <input type="checkbox" class="task-checkbox" onchange="toggleTask(this)">
            <div class="task-content">
              <div class="task-title">【プライベート】歯医者の予約</div>
              <div class="task-meta">19:00〜19:30</div>
            </div>
          </li>
        </ul>
      </section>

      <!-- もうすぐ締め切り -->
      <section class="card">
        <h2 class="card-title">もうすぐ締め切り（直近3日間）</h2>
        <ul class="task-list">
          <li class="task-item">
            <input type="checkbox" class="task-checkbox" onchange="toggleTask(this)">
            <div class="task-content">
              <div class="task-title">【仕事】週次報告書の作成</div>
              <div class="task-meta">9月10日(木) 12:00まで</div>
            </div>
            <span class="badge badge-warning">あと2日</span>
          </li>
        </ul>
      </section>
    </main>

    <!-- 右側：簡易カレンダー＆警告メッセージ -->
    <aside>
      <section class="card">
        <div class="calendar-header">
          <span>2026年 9月</span>
          <span class="calendar-legend">● 予定あり</span>
        </div>

        <div class="calendar-grid">
          <div class="calendar-day-head head-sun">日</div>
          <div class="calendar-day-head">月</div>
          <div class="calendar-day-head">火</div>
          <div class="calendar-day-head">水</div>
          <div class="calendar-day-head">木</div>
          <div class="calendar-day-head">金</div>
          <div class="calendar-day-head head-sat">土</div>

          <div class="calendar-day day-disabled">30</div>
          <div class="calendar-day day-disabled">31</div>
          <div class="calendar-day">1</div>
          <div class="calendar-day">2</div>
          <div class="calendar-day">3</div>
          <div class="calendar-day">4</div>
          <div class="calendar-day">5</div>
          <div class="calendar-day">6</div>
          <div class="calendar-day">7</div>
          <div class="calendar-day today has-event" title="予定重なり注意">8</div>
          <div class="calendar-day">9</div>
          <div class="calendar-day has-event" title="締め切りあり">10</div>
          <div class="calendar-day">11</div>
          <div class="calendar-day">12</div>
        </div>

        <div class="alert-box">
          ⚠️ <strong>9月8日の注意点:</strong><br>17:00締切のタスクと19:00の予定が近く、時間が圧迫されています。
        </div>
      </section>
    </aside>
  </div>

  <!-- タスク・予定追加モーダル（Rails Model 連携版） -->
  <div class="modal" id="taskModal">
    <div class="modal-content">
      <h3 class="modal-title">＋ 予定・タスクを追加</h3>
      
      <%= form_with model: @task, url: tasks_path, local: true, id: "addTaskForm" do |f| %>
        <!-- status 初期値を todo で送信 -->
        <%= f.hidden_field :status, value: "todo" %>

        <!-- 1. 件名 / タイトル -->
        <div class="form-group">
          <%= f.label :title, "内容・件名", class: "form-label" %>
          <%= f.text_field :title, class: "form-input", placeholder: "例：【仕事】企画書の提出、歯医者など", required: true %>
        </div>

        <!-- 2. 種別 (item_type) -->
        <div class="form-group">
          <%= f.label :item_type, "種別", class: "form-label" %>
          <%= f.select :item_type, 
                [
                  ['🔴 タスク（いつまでにやるか・締め切り）', 'task'], 
                  ['🔵 予定・約束（開始時間〜終了時間）', 'schedule']
                ], 
                {}, 
                { class: "form-input", id: "itemTypeSelect", onchange: "toggleFormFields()" } %>
        </div>

        <!-- 3-A. タスク用フィールド -->
        <div id="taskFields">
          <div class="form-group">
            <%= f.label :due_date, "締め切り日時", class: "form-label" %>
            <%= f.datetime_field :due_date, class: "form-input", id: "inputDueDate" %>
          </div>

          <div class="form-group">
            <%= f.label :priority, "優先度", class: "form-label" %>
            <%= f.select :priority, 
                  [
                    ['高', 'high'], 
                    ['中', 'medium'], 
                    ['低', 'low']
                  ], 
                  { selected: 'medium' }, 
                  { class: "form-input" } %>
          </div>
        </div>

        <!-- 3-B. 予定用フィールド -->
        <div id="scheduleFields" style="display: none;">
          <div class="form-row">
            <div class="form-group">
              <%= f.label :start_time, "開始日時", class: "form-label" %>
              <%= f.datetime_field :start_time, class: "form-input", id: "inputStartTime" %>
            </div>
            <div class="form-group">
              <%= f.label :end_time, "終了日時", class: "form-label" %>
              <%= f.datetime_field :end_time, class: "form-input", id: "inputEndTime" %>
            </div>
          </div>
        </div>

        <!-- アクションボタン -->
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">キャンセル</button>
          <%= f.submit "登録する", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- JavaScript -->
  <script>
    // 1. 進行度メーターの計算機能
    function updateProgress() {
      const todayList = document.getElementById('today-task-list');
      if (!todayList) return;

      const checkboxes = todayList.querySelectorAll('.task-checkbox');
      const total = checkboxes.length;
      let checkedCount = 0;

      checkboxes.forEach(cb => {
        if (cb.checked) checkedCount++;
      });

      const remaining = total - checkedCount;
      const percent = total === 0 ? 0 : Math.round((checkedCount / total) * 100);

      document.getElementById('summary-remaining').textContent = `今日やるべきこと：あと ${remaining} 件`;
      document.getElementById('summary-progress-text').textContent = `本日の進行度 (${checkedCount}/${total} 完了)`;
      document.getElementById('progress-bar-fill').style.width = `${percent}%`;
    }

    // 2. チェックボックス切り替え時の打ち消し線処理
    function toggleTask(checkbox) {
      const taskTitle = checkbox.nextElementSibling.querySelector('.task-title');
      if (checkbox.checked) {
        taskTitle.style.textDecoration = 'line-through';
        taskTitle.style.color = '#94a3b8';
      } else {
        taskTitle.style.textDecoration = 'none';
        taskTitle.style.color = '#1e293b';
      }
      updateProgress();
    }

    // 3. 種別（タスク／予定）に応じた入力フィールドの動的切り替え
    function toggleFormFields() {
      const itemTypeSelect = document.getElementById('itemTypeSelect');
      if (!itemTypeSelect) return;

      const itemType = itemTypeSelect.value;
      const taskFields = document.getElementById('taskFields');
      const scheduleFields = document.getElementById('scheduleFields');

      const dueDateInput = document.getElementById('inputDueDate');
      const startTimeInput = document.getElementById('inputStartTime');

      if (itemType === 'task') {
        if (taskFields) taskFields.style.display = 'block';
        if (scheduleFields) scheduleFields.style.display = 'none';
        if (dueDateInput) dueDateInput.required = true;
        if (startTimeInput) startTimeInput.required = false;
      } else {
        if (taskFields) taskFields.style.display = 'none';
        if (scheduleFields) scheduleFields.style.display = 'block';
        if (dueDateInput) dueDateInput.required = false;
        if (startTimeInput) startTimeInput.required = true;
      }
    }

    // 4. モーダルの開閉制御
    function openModal() { 
      const modal = document.getElementById('taskModal');
      if (modal) {
        modal.style.display = 'flex'; 
        toggleFormFields();
      }
    }
    
    function closeModal() { 
      const modal = document.getElementById('taskModal');
      if (modal) {
        modal.style.display = 'none'; 
      }
    }

    // 背景モーダル部分クリックで閉じる
    window.addEventListener('click', function(event) {
      const modal = document.getElementById('taskModal');
      if (event.target === modal) {
        closeModal();
      }
    });

    // 画面読み込み時の初期化
    document.addEventListener('turbo:load', updateProgress);
    document.addEventListener('DOMContentLoaded', updateProgress);
  </script>
</div>