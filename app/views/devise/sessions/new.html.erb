<div class="auth-container">
  <!-- ヘッダー -->
  
  <header>
    <div class="logo">TaskNavi</div>
  </header>

  <!-- メインコンテンツ -->
  <main class="auth-main">
    <div class="card auth-card">
      <h1 class="auth-title">ログイン</h1>
      <p class="auth-subtitle">TaskNavi アカウントにログイン</p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <div class="form-group">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "name@example.com" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-input", placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-checkbox-group">
            <%= f.check_box :remember_me, class: "form-checkbox" %>
            <%= f.label :remember_me, "ログイン状態を保持する", class: "checkbox-label" %>
          </div>
        <% end %>

        <div class="form-actions">
          <%= f.submit "ログイン", class: "btn btn-primary btn-block" %>
        </div>
      <% end %>

      <div class="auth-footer-links">
        <%= link_to "新規登録はこちら", new_user_registration_path, class: "auth-link" %>
      </div>
    </div>
  </main>

  <!-- フッター -->
  <footer class="footer">
    &copy; <%= Time.current.year %> TaskNavi. All rights reserved.
  </footer>
</div>
