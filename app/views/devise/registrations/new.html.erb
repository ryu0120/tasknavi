<div class="auth-container">
  <!-- ヘッダー -->
  
  <header>
    <div class="logo">TaskNavi</div>
  </header>

  <!-- メインコンテンツ -->
  <main class="auth-main">
    <div class="card auth-card">
      <h1 class="auth-title">新規登録</h1>
      <p class="auth-subtitle">TaskNavi のアカウントを作成</p>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <%= render "shared/error_messages", model: f.object %>

        <div class="form-group">
          <%= f.label :nickname, "ニックネーム", class: "form-label" %>
          <%= f.text_field :nickname, autofocus: true, autocomplete: "nickname", class: "form-input", placeholder: "タスク太郎" %>
        </div>

        <div class="form-group">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "form-input", placeholder: "name@example.com" %>
        </div>

        <div class="form-group">
          <div class="label-with-hint">
            <%= f.label :password, "パスワード", class: "form-label" %>
            <% if @minimum_password_length %>
              <span class="form-hint">(<%= @minimum_password_length %>文字以上)</span>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-input", placeholder: "••••••••" %>
        </div>

        <div class="form-group">
          <%= f.label :password_confirmation, "パスワード（確認用）", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input", placeholder: "••••••••" %>
        </div>

        <div class="form-actions">
          <%= f.submit "アカウントを作成", class: "btn btn-primary btn-block" %>
        </div>
      <% end %>

      <div class="auth-footer-links">
        <%= link_to "すでにアカウントをお持ちの方はこちら", new_user_session_path, class: "auth-link" %>
      </div>
    </div>
  </main>

  <!-- フッター -->
  <footer class="footer">
    &copy; <%= Time.current.year %> TaskNavi. All rights reserved.
  </footer>
</div>